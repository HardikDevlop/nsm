APP_NAME=NMS Backend
ENVIRONMENT=production
# Point this to the PostgreSQL database that already contains your NMS tables.
# In the current local setup, the live data is stored in the existing `postgres` database.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/postgres
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CREDENTIAL_ENCRYPTION_KEY=
# Comma-separated browser origins. With Nginx same-origin, use the frontend URL.
BACKEND_CORS_ORIGINS=https://nms.example.com
# Flow ingestion is opt-in. NetFlow v5/v9 and IPFIX share the NetFlow port.
FLOW_ENABLED=false
FLOW_BIND_HOST=0.0.0.0
FLOW_NETFLOW_PORT=2055
FLOW_SFLOW_PORT=6343
BRANDING_APPLICATION_NAME=NMS
BRANDING_LOGO_URL=
BRANDING_ALLOWED_THEMES=light,dark
