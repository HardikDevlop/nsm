APP_NAME=NMS Backend
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://nms_user:CHANGE_ME@127.0.0.1:5432/nms_db
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CREDENTIAL_ENCRYPTION_KEY=
# Comma-separated browser origins. With Nginx same-origin, use the frontend URL.
BACKEND_CORS_ORIGINS=https://nms.example.com
